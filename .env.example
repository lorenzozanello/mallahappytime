# ─── Supabase (required in production) ─────────────────────────────────────────
# Project URL and public (anon / publishable) key. Safe for the browser: RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: ONLY for server-side scripts (npm run curriculum:embed). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used in magic-link emails (e.g. https://malla.happytime.edu.co)
NEXT_PUBLIC_SITE_URL=

# ─── Happy (AI) ────────────────────────────────────────────────────────────────
# Model as "<provider>/<model>". Default: anthropic/claude-sonnet-5 (see docs/DECISIONS.md).
HAPPY_MODEL=anthropic/claude-sonnet-5
# Credentials, choose ONE route:
#  a) Vercel AI Gateway (recommended; on Vercel, OIDC auth works without a key)
AI_GATEWAY_API_KEY=
#  b) Direct provider key matching HAPPY_MODEL's provider (use that provider's model naming)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Embeddings for semantic search (1536 dims to match the pgvector column).
HAPPY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: prices (USD per million tokens) to estimate cost in the admin panel.
HAPPY_COST_INPUT_PER_MTOK=
HAPPY_COST_OUTPUT_PER_MTOK=
# Optional: judge model for npm run eval:happy -- --generate
HAPPY_EVAL_JUDGE_MODEL=

# ─── Demo / development only ───────────────────────────────────────────────────
# true = no real auth; role picker; workspace in a local JSON file (NOT durable on Vercel).
HAPPY_DEMO_MODE=false
# HAPPY_MODEL=mock/grounded is a deterministic test model, only allowed in demo mode/tests.
HAPPY_DATA_DIR=
